# ─── Required ─────────────────────────────────────────────────────────────────
VITE_ERP_BASE_URL=erp_base_url_here
VITE_OAUTH_CLIENT_ID=your_client_id_here

# ─── Optional ──────────────────────────────────────────────────────────────────
# redirect URI defaults to: window.location.origin + /auth/callback
# Only set this if your dev server runs on a non-standard origin
# VITE_REDIRECT_URI=http://localhost:3000/auth/callback
